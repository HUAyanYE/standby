# Context Engine Dockerfile
# 用法: docker build -f Dockerfile.context -t standby-context .

FROM python:3.12-slim AS deps
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends build-essential && rm -rf /var/lib/apt/lists/*
COPY engines/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

FROM python:3.12-slim
WORKDIR /app
COPY --from=deps /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY --from=deps /usr/local/bin /usr/local/bin
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 && rm -rf /var/lib/apt/lists/*

COPY engines/pyproject.toml /app/engines/
COPY engines/standby_common /app/engines/standby_common
RUN pip install -e /app/engines

COPY engines/config /app/engines/config
COPY src/proto /app/src/proto
COPY engines/context_engine /app/engines/context_engine

ENV ENGINE_NAME=context_engine
ENV PORT=8094
EXPOSE 8094

HEALTHCHECK --interval=30s --timeout=5s --retries=3 CMD python3 -c "import sys; sys.exit(0)"
CMD ["python3", "/app/engines/context_engine/service.py"]
