# Force LF line endings for all text files
* text=auto eol=lf

# Explicitly text files
*.dart text eol=lf
*.rs text eol=lf
*.py text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.sql text eol=lf
*.proto text eol=lf
*.sh text eol=lf
*.env text eol=lf
*.gitattributes text eol=lf
*.gitignore text eol=lf
*.dockerignore text eol=lf
Dockerfile text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.onnx binary
